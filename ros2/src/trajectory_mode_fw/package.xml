<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trajectory_mode_fw</name>
  <version>0.1.0</version>
  <description>External PX4 flight mode "Trajectory" for fixed-wing flight (VTOL in FW): the virtual-target
    sliding-mode guidance of the internal Trajectory mode, with fixed-wing lateral/longitudinal setpoints.</description>
  <maintainer email="anujaya95@gmail.com">anujaya</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <build_depend>eigen</build_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>px4_ros2_cpp</depend>
  <depend>libmosquitto-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
